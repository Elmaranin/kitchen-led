CONFIG_ESP8266_DEFAULT_CPU_FREQ_80=y
# CONFIG_PM_ENABLE is not set
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_TWO_OTA=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_ENABLE_MDNS=y
CONFIG_KITCHEN_LED_COLOR_ORDER_RGB=y
CONFIG_KITCHEN_LINE_1_LEDS=36
CONFIG_KITCHEN_LINE_2_LEDS=36
CONFIG_KITCHEN_LINE_3_LEDS=36
CONFIG_KITCHEN_LINE_4_LEDS=36

CONFIG_KITCHEN_LINE_1_SWAP_RG=y
CONFIG_KITCHEN_LINE_2_SWAP_RG=y
CONFIG_KITCHEN_LINE_3_SWAP_RG=y
CONFIG_KITCHEN_LINE_4_SWAP_RG=y
